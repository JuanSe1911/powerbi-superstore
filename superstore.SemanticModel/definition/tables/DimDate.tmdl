	column YearMonth
		lineageTag: 46d807a2-1fd6-4b16-bf1b-061f94e6cae2
		summarizeBy: none
		isNameInferred
		sourceColumn: [YearMonth]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(YEAR(MIN(FactSales[Order Date])), 1, 1),
				        DATE(YEAR(MAX(FactSales[Ship Date])), 12, 31)
				    ),
				    "Year", YEAR([Date]),
				    "MonthNum", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Quarter", "Q" & QUARTER([Date]),
				    "YearMonth", FORMAT([Date], "YYYY-MM")
				)

	annotation PBI_Id = e3a1f95426094183a7d2dc2aad107d8f

