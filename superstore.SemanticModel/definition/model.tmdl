model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Superstore_Raw","DimCustomer","DimProduct","DimGeography","FactSales","_Measures"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table DimCustomer
ref table DimProduct
ref table DimGeography
ref table FactSales
ref table DimDate
ref table _Measures

ref cultureInfo en-US

